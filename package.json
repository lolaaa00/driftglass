{
  "name": "driftglass",
  "version": "0.1.0",
  "private": true,
  "description": "Authority-bound semantic guarantees enforced by GenLayer consensus.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:contract": "python3 -m pytest tests/contract -q",
    "check:contract": "python3 scripts/contract_static_checks.py && genvm-lint check contracts/driftglass.py",
    "check:network": "node scripts/check-network.mjs",
    "check:clean": "python3 scripts/release_scan.py",
    "verify": "npm run lint && npm run typecheck && npm test && npm run test:contract && npm run check:contract && npm run check:network && npm run check:clean && npm run build",
    "genlayer": "genlayer",
    "genlayer:version": "genlayer --version"
  },
  "dependencies": {
    "genlayer-js": "1.1.8",
    "lucide-react": "0.468.0",
    "next": "16.3.8",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.1.0",
    "@types/node": "22.10.5",
    "@types/react": "19.0.3",
    "@types/react-dom": "19.0.2",
    "@vitejs/plugin-react": "4.3.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "genlayer": "0.39.1",
    "jsdom": "25.0.1",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  }
}
